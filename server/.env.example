NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://mongo:27017/taskflow
JWT_ACCESS_SECRET=your_access_secret_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_change_in_production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_RESET_SECRET=your_reset_secret_change_in_production
JWT_RESET_EXPIRES=1h
COOKIE_DOMAIN=localhost
CLIENT_URL=http://localhost:3000
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=noreply@taskflow.com
EMAIL_PASS=your_email_password
EMAIL_FROM=TaskFlow <noreply@taskflow.com>
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOG_LEVEL=info
